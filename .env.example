# ══════════════════════════════════════════════════════════════
# SafeLane — Environment Configuration
# Copy this file to .env and fill in values as needed.
# ══════════════════════════════════════════════════════════════

# ── Required for Setup Platform ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── GitHub Direct OAuth Authorization (Required for seamless authorization) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── Required for GitHub webhook verification (Optional if using OAuth) ──
GITHUB_WEBHOOK_SECRET=

# ── Required for the Fabric Controller (set to the public URL of the orchestrator) ──
SAFELANE_ORCHESTRATOR_URL=http://localhost:8000

# ── Database (default: SQLite for local dev) ──
DATABASE_URL=sqlite+aiosqlite:///./safelane.db

# ── Azure OpenAI (Optional — unlocks richer AI-written explanations) ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Azure AI Search (Optional — unlocks real Incident Memory history) ──
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

# ── Microsoft Foundry / App Insights (Optional — unlocks tracing dashboards) ──
AZURE_FOUNDRY_PROJECT_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Freemium limit (0 = unlimited for demo) ──
SAFELANE_FREE_TIER_LIMIT=0
