FROM python:3.12-slim

WORKDIR /app

# Install system dependencies if any are needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
COPY platform/requirements.txt platform/

RUN pip install --no-cache-dir -r requirements.txt -r platform/requirements.txt

COPY . .
ENV PYTHONPATH=/app

EXPOSE 8080

CMD ["uvicorn", "platform.server.app:app", "--host", "0.0.0.0", "--port", "8080"]
